---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EntryHeader from '../../../components/EntryHeader.astro';
import { t } from '../../../lib/locale';

type Entry = CollectionEntry<'articles'> | CollectionEntry<'fragments'> | CollectionEntry<'archive'>;

export async function getStaticPaths() {
  const [articles, fragments, archive] = await Promise.all([
    getCollection('articles', ({ data }) => !data.draft),
    getCollection('fragments'),
    getCollection('archive')
  ]);
  return [...articles, ...fragments, ...archive].map((entry) => ({
    params: { section: entry.collection, slug: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props as { entry: Entry };
const { Content } = await render(entry);
const rootPath = `/${entry.collection}/${entry.id}/`;
---

<BaseLayout title={entry.data.title} description={entry.data.description} pathname={`/en${rootPath}`} canonicalPath={rootPath} locale="en" noindex image={entry.data.cover} type="article">
  <EntryHeader entry={entry} locale="en" />
  <p class="original-language">{t('en', 'originalLanguage')}</p>
  {entry.collection === 'archive' && <p class="original-language">{t('en', 'archiveDisclosure')}</p>}
  {entry.data.cover && <img class="reading-cover" src={entry.data.cover} alt={entry.collection === 'archive' ? 'Chen Xiangwan archive image.' : 'Entry cover image.'} width="1672" height="941" />}
  <article class="reading-shell prose"><Content /></article>
</BaseLayout>
