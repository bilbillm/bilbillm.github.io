---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContentCard from '../../../components/ContentCard.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { getArchiveEntries, getArticles, getFragments, getProjects } from '../../../lib/content';

export function getStaticPaths() {
  return ['articles', 'fragments', 'archive', 'projects'].map((section) => ({ params: { section } }));
}

const section = Astro.params.section as 'articles' | 'fragments' | 'archive' | 'projects';
const [articles, fragments, archive, projects] = await Promise.all([getArticles(), getFragments(), getArchiveEntries(), getProjects()]);
const page = {
  articles: { title: 'Writing', description: 'Long-form writing in its original language.' },
  fragments: { title: 'Fragments', description: 'Independent images, quotations, and short notes.' },
  archive: { title: 'Archive', description: 'A curated public dossier of Chen Xiangwan.' },
  projects: { title: 'Projects', description: 'Each project points to a repository or a real demo.' }
}[section];
---

<BaseLayout title={page.title} description={page.description} pathname={`/en/${section}/`} canonicalPath={`/${section}/`} locale="en" noindex>
  <div class="page-shell">
    <header class="page-header"><p class="page-header__eyebrow">{section.toUpperCase()}</p><h1>{page.title}</h1><p>{page.description}</p></header>
    {section !== 'projects' && <p class="original-language">This interface is in English; the entries remain in their original language.</p>}
    {section === 'articles' && <div class="content-grid">{articles.map((entry) => <ContentCard entry={entry} locale="en" />)}</div>}
    {section === 'fragments' && <div class="content-grid">{fragments.map((entry) => <ContentCard entry={entry} locale="en" />)}</div>}
    {section === 'archive' && <div class="content-grid">{archive.map((entry) => <ContentCard entry={entry} locale="en" />)}</div>}
    {section === 'projects' && <div class="project-grid">{projects.map((project) => <ProjectCard project={project} locale="en" />)}</div>}
  </div>
</BaseLayout>
