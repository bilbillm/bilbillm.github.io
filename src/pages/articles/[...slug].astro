---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryHeader from '../../components/EntryHeader.astro';

export async function getStaticPaths() {
  const entries = await getCollection('articles', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'articles'> };
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} pathname={`/articles/${entry.id}/`} noindex={entry.data.noindex} image={entry.data.cover} type="article">
  <EntryHeader entry={entry} locale="zh" />
  {entry.data.cover && <img class="reading-cover" src={entry.data.cover} alt="文章封面。" width="1672" height="941" />}
  <article class="reading-shell prose"><Content /></article>
</BaseLayout>
