---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryHeader from '../../components/EntryHeader.astro';
import { t } from '../../lib/locale';

export async function getStaticPaths() {
  const entries = await getCollection('archive');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'archive'> };
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description} pathname={`/archive/${entry.id}/`} noindex={entry.data.noindex} image={entry.data.cover} type="article">
  <EntryHeader entry={entry} locale="zh" />
  <p class="original-language">{t('zh', 'archiveDisclosure')}</p>
  {entry.data.cover && <img class="reading-cover" src={entry.data.cover} alt="陈向晚档案图像。" width="1672" height="941" />}
  <article class="reading-shell prose"><Content /></article>
</BaseLayout>
